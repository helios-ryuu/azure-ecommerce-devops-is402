#################################################################################
# Repo: azure-ecommerce-devops-is402 | Dự án: avn-with-vnet-peering             #
# Môn học: IS402 - Điện toán đám mây (UIT)                                      #
# Thư mục: avn-with-vnet-peering/terraform/terraform.tfvars.example             #
# Mô tả: Tệp biến mẫu cấu hình chuẩn theo sơ đồ bài Lab VNet Peering           #
# Hướng dẫn: Sao chép tệp này thành terraform.tfvars và tùy biến nếu cần:      #
#            cp terraform.tfvars.example terraform.tfvars                       #
#################################################################################

# 1. Nhóm tài nguyên Resource Group
resource_group_name = "rg-asm"

# 2. Mạng 1 (Bên trái sơ đồ: 10.0.0.0/16 & Subnet 10.0.0.0/24)
location_marketing           = "eastasia"
vnet_marketing_name          = "vnet-1"
vnet_marketing_address_space = ["10.0.0.0/16"]
subnet_marketing_name        = "subnet-1"
subnet_marketing_cidr        = ["10.0.0.0/24"]
vm_marketing_private_ip      = "10.0.0.100"

# 3. Mạng 2 (Bên phải sơ đồ: 192.168.0.0/20 & Subnet 192.168.0.0/24)
location_dev            = "koreacentral"
vnet_dev_name           = "vnet-2"
vnet_dev_address_space  = ["192.168.0.0/20"]
subnet_dev_name         = "subnet-2"
subnet_dev_cidr         = ["192.168.0.0/24"]

# 4. Cấu hình Máy ảo (VMs) & Đăng nhập Serial Console
vm_size        = "Standard_B2as_v2" # B-series v2 AMD (2 vCPU, 8 GiB RAM)
admin_username = "azureuser"
admin_password = "AzureLab@123456"

# 5. Kịch bản kiểm thử Peering
enable_peering               = true
allow_virtual_network_access = true
allow_forwarded_traffic      = true

# 6. Metadata Tags
tags = {
  Project     = "avn-with-vnet-peering"
  Environment = "Lab"
  Course      = "IS402"
  ManagedBy   = "Terraform"
  LabName     = "VNet-Peering"
}

